{
  "name": "astro-adapter-cloudflare-pages",
  "version": "0.0.0",
  "description": "Astro adapter for deploying on-demand rendered sites to Cloudflare Pages (Astro 6, 7 and later)",
  "keywords": [
    "astro",
    "astro-adapter",
    "astro-integration",
    "withastro",
    "cloudflare",
    "cloudflare-pages",
    "pages",
    "cf-pages",
    "wrangler",
    "cf"
  ],
  "homepage": "https://github.com/otnc/astro-adapter-cloudflare-pages#readme",
  "bugs": {
    "url": "https://github.com/otnc/astro-adapter-cloudflare-pages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/astro-adapter-cloudflare-pages.git"
  },
  "license": "MIT",
  "author": "otoneko.",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0",
    "wrangler": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "wrangler": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check": "prettier --write . && eslint --fix .",
    "ci": "prettier --check . && eslint .",
    "prepublishOnly": "npm run build",
    "skills:link": "node scripts/link-claude-skills.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.1",
    "astro": "^7.3.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
