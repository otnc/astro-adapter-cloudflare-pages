# Normalize all text files to LF, regardless of the platform or the contributor's core.autocrlf setting, so Prettier (which writes LF) never disagrees with what's checked out on Windows.
* text=auto eol=lf

.agents/skills/** linguist-vendored

# Linguist treats test/fixtures/ as vendored and Astro as markup, so neither counts toward the language bar by default.
test/fixtures/** linguist-vendored=false
*.astro linguist-detectable
